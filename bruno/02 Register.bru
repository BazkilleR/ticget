meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  // New user each run, unless you set `username` yourself in the environment.
  if (!bru.getEnvVar("username")) {
    bru.setVar("username", "demo_" + Date.now());
  }
}

tests {
  test("201 created (409 if the username already exists)", function () {
    expect([201, 409]).to.include(res.getStatus());
  });
}
