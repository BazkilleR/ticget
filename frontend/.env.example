# Base path of the backend API as seen by the browser. Keep /api for same-origin calls
# (Vite dev proxy locally, Amplify rewrite rule on AWS). Only set a full URL if CORS is enabled on the API.
VITE_API_BASE=/api

# Dev server only: where the /api proxy forwards to (not exposed to the browser bundle).
API_PROXY_TARGET=http://localhost:3000
