PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://app:app@localhost:5433/tickets
REDIS_URL=redis://localhost:6379
AWS_REGION=ap-southeast-1
# Local only (LocalStack). Leave unset on AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_BOOKING_QUEUE_URL=http://localhost:4566/000000000000/booking-queue.fifo
JWT_SECRET=change-me-to-a-long-random-string
BOOKING_HOLD_MINUTES=10
MAX_TICKETS_PER_USER=4
# Admin account created by `npm run seed` (local only; on AWS pass a long password in the shell).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
