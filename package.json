{
  "name": "ticket-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zone-based concert/event ticket booking backend",
  "main": "src/api.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:api": "node src/api.js",
    "start:worker": "node src/worker.js",
    "dev": "docker compose up -d --wait && npm run -s migrate && concurrently --kill-others-on-fail --names api,worker,web --prefix-colors blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch src src/api.js",
    "dev:worker": "nodemon --watch src src/worker.js",
    "expire": "node src/jobs/expire.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo-sales.js",
    "test": "jest --runInBand",
    "load:prepare": "node load/prepare.js",
    "load:run": "docker run --rm -i --network host -v \"$PWD/load:/load\" -w /load grafana/k6 run booking-rush.js",
    "load:verify": "node load/verify.js",
    "aws:build-image": "bash infra/scripts/build-image.sh",
    "aws:bootstrap": "cd infra && npx cdk bootstrap",
    "aws:synth": "npm run aws:build-image && cd infra && npx cdk synth --quiet",
    "aws:deploy": "npm run aws:build-image && cd infra && npx cdk deploy",
    "aws:destroy": "bash infra/scripts/destroy.sh",
    "aws:tunnel": "bash infra/scripts/tunnel.sh",
    "aws:ssh": "bash infra/scripts/tunnel.sh shell",
    "aws:env": "bash infra/scripts/aws-env.sh",
    "aws:amplify-rewrites": "bash infra/scripts/amplify-rewrites.sh",
    "dev:web": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1142.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testTimeout": 20000
  },
  "allowScripts": {
    "bcrypt": false,
    "esbuild": false
  }
}
