{
  "name": "ticket-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zone-based concert/event ticket booking backend",
  "main": "src/api.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:api": "node src/api.js",
    "start:worker": "node src/worker.js",
    "dev:api": "nodemon --watch src src/api.js",
    "dev:worker": "nodemon --watch src src/worker.js",
    "expire": "node src/jobs/expire.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testTimeout": 20000
  },
  "allowScripts": {
    "bcrypt": false
  }
}
